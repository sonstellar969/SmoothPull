{
  "manifest_version": 3,
  "name": "SmoothPull",
  "version": "1.0.0",
  "description": "Smooth pull-to-refresh gestures for Firefox on macOS trackpads.",
  "permissions": ["tabs"],
  "browser_specific_settings": {
    "gecko": {
      "id": "pull-to-refresh@example.local",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
